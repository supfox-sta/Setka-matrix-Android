# /etc/matrix-synapse/setka_plus.yaml

robokassa_merchant_login: "your_shop_login"
robokassa_password1: "password_1"
robokassa_password2: "password_2"
robokassa_is_test: true

public_base_url: "https://matrix.setka-matrix.ru"

plans:
  - id: setka_plus_month
    name: "Setka Plus — 30 дней"
    price_rub: 199
    duration_days: 30
    features:
      - "Стикеры и эмодзи"
      - "Обмен паками"
    active: true
    sort_order: 0
